rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Security: Users cannot list other users
      allow create: if isOwner(userId) 
        && request.resource.data.keys().hasAll(['uid', 'email', 'balance', 'createdAt'])
        && request.resource.data.balance == 1000 // Initial bonus
        && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'displayName']);
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Game Stats
    match /game_stats/{gameId} {
      allow read: if true; // Public stats
      allow write: if false; // System only
    }
  }
}
